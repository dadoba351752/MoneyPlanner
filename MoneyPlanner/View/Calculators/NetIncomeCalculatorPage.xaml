<UserControl x:Class="MoneyPlanner.NetIncomeCalculatorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoneyPlanner"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsEnabled" Value="False"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="10"></Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
            <Setter Property="TextWrapping" Value="WrapWithOverflow"></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden">
        <Grid Margin="20, 20, 0, 0">
        <Grid.RowDefinitions>
               <RowDefinition Height="auto"/>
               <RowDefinition Height="auto"/>
               <RowDefinition Height="auto"/>
               <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">Výpočet čisté mzdy (2025)</Label>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Vaše hrubá mzda v Kč</Label>
            <TextBox Grid.Row="0" Grid.Column="1" IsEnabled="True" Text="{Binding GrossIncome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label Grid.Row="1" Grid.Column="0">Sociální a nemocenské pojištění placené zaměstnancem</Label>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmployeeSocialInsurance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="2" Grid.Column="0">Zdravotní pojištění placené zaměstnancem</Label>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmployeeHealthInsurance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="3" Grid.Column="0">Záloha na daň před odečtením slev</Label>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TaxAdvanceBeforeAllowance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="4" Grid.Column="0">Záloha na daň</Label>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TaxAdvance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="5" Grid.Column="0">Daňový bonus</Label>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TaxBonus, Mode=OneWay}"></TextBox>

                <Label Grid.Row="6" Grid.Column="0" FontWeight="Bold">Čistý měsíční příjem celkem</Label>
                <TextBox Grid.Row="6" Grid.Column="1" FontWeight="Bold" Text="{Binding NetIncome, Mode=OneWay}"></TextBox>

                <Label Grid.Row="7" Grid.Column="0">Sociální pojištění placené zaměstnavatelem</Label>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EmployerSocialInsurance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="8" Grid.Column="0">Zdravotní pojištění placené zaměstnavatelem</Label>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EmployerHealthInsurance, Mode=OneWay}"></TextBox>

                <Label Grid.Row="9" Grid.Column="0" FontWeight="SemiBold">Celkové náklady zaměstnavatele na zaměstnance</Label>
                <TextBox Grid.Row="9" Grid.Column="1" FontWeight="SemiBold" Text="{Binding EmployerCostPerEmployee, Mode=OneWay}"></TextBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">Další parametry - bude doplněno později</Label>
            </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0">Sleva na poplatníka</Label>
                <CheckBox Grid.Row="0" Grid.Column="1" Margin="10" IsChecked="{Binding TaxpayerAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TaxpayerAllowanceValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="1" Grid.Column="0">Počet dětí, na které je uplatňována sleva na dani</TextBlock>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="10" VerticalAlignment="Center" Text="{Binding TaxDeductionChildrenCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Žádné"></ComboBoxItem>
                    <ComboBoxItem Content="1 dítě"></ComboBoxItem>
                    <ComboBoxItem Content="2 děti"></ComboBoxItem>
                    <ComboBoxItem Content="3 děti"></ComboBoxItem>
                    <ComboBoxItem Content="4 děti"></ComboBoxItem>
                    <ComboBoxItem Content="5 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="6 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="7 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="8 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="9 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="10 dětí"></ComboBoxItem>
                </ComboBox>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding TaxDeductionChildrenValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="WrapWithOverflow">Z toho počet dětí s průkazem ZTP/P</TextBlock>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="10" VerticalAlignment="Center" Text="{Binding TaxDeductionZtppChildrenCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Žádné"></ComboBoxItem>
                    <ComboBoxItem Content="1 dítě"></ComboBoxItem>
                    <ComboBoxItem Content="2 děti"></ComboBoxItem>
                    <ComboBoxItem Content="3 děti"></ComboBoxItem>
                    <ComboBoxItem Content="4 děti"></ComboBoxItem>
                    <ComboBoxItem Content="5 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="6 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="7 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="8 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="9 dětí"></ComboBoxItem>
                    <ComboBoxItem Content="10 dětí"></ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0">Sleva na invaliditu 1. nebo 2. stupně</TextBlock>
                <CheckBox Grid.Row="3" Grid.Column="1" Margin="10" IsChecked="{Binding LowerInvalidityAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding LowerInvalidityAllowanceValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="4" Grid.Column="0">Sleva na invaliditu 3. stupně</TextBlock>
                <CheckBox Grid.Row="4" Grid.Column="1" Margin="10" IsChecked="{Binding HigherInvalidityAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding HigherInvalidityAllowanceValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="5" Grid.Column="0">Sleva na držitele průkazu ZTP/P</TextBlock>
                <CheckBox Grid.Row="5" Grid.Column="1" Margin="10" IsChecked="{Binding ZtppAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding ZtppAllowanceValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="6" Grid.Column="0">Sleva na manžela/ku pečující o dítě do 3 let</TextBlock>
                <CheckBox Grid.Row="6" Grid.Column="1" Margin="10" IsChecked="{Binding SpouseAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding SpouseAllowanceValue, Mode=OneWay}"></TextBox>

                <TextBlock Grid.Row="7" Grid.Column="0">Sleva na manžela/ku ZTP/P pečující o dítě do 3 let</TextBlock>
                <CheckBox Grid.Row="7" Grid.Column="1" Margin="10" IsChecked="{Binding ZtppSpouseAllowanceCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding ZtppSpouseAllowanceValue, Mode=OneWay}"></TextBox>
            </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
