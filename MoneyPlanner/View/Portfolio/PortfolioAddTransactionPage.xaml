<UserControl x:Class="MoneyPlanner.View.Portfolio.PortfolioAddTransactionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoneyPlanner.View.Portfolio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Text="Přidat investici:"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding NameTextBlock, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"></TextBlock>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Název CP:" HorizontalAlignment="Left"></TextBlock>
        <TextBox Grid.Row="2" Grid.Column="0" Width="250"  Text="{Binding InvestmentNameTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        
        <Button Grid.Row="3" Width="100" Click="ConfirmInvestmentNameButton_Click">Potvrdit CP</Button>
        
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Množství:" HorizontalAlignment="Left"></TextBlock>
        <TextBox Grid.Row="4" Grid.Column="0" Width="150"  Text="{Binding InvestmentAmountTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Cena za akcii:" HorizontalAlignment="Left"></TextBlock>
        <TextBox Grid.Row="5" Grid.Column="0" Width="150"  Text="{Binding InvestmentPriceTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Objem:" HorizontalAlignment="Left"></TextBlock>
        <TextBox Grid.Row="6" Grid.Column="0" Width="150"  Text="{Binding InvestmentVolumeTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Datum:" HorizontalAlignment="Left"></TextBlock>
        <DatePicker Grid.Row="7" Grid.Column="0" Language="cs-CZ" Width="150" Text="{Binding InvestmentDateTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DatePicker>

        <Button Grid.Row="8" Grid.Column="0" Background="LightGreen" Width="100" HorizontalAlignment="Center" Content="Přidat investici" Click="ConfirmInvestmentButton_Click"></Button>

        <Button Grid.Row="9" Grid.Column="0" Click="GoBackButton_Click" Content="Zpět" Width="50" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"></Button>
    </Grid>
</UserControl>
