<UserControl x:Class="MoneyPlanner.View.Portfolio.PortfolioUserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoneyPlanner.View.Portfolio"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#2f3c61">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="White"></Setter>
                    <Setter Property="Background" Value="#2f3c61"></Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="Black" BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5479e8"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="Finanční portfolio" FontWeight="DemiBold" FontSize="15" Margin="5, 10, 0, 20" Foreground="White"></TextBlock>
            <Button  Grid.Row="1" Click="AddInvestmentButton_Click" Width="150" Content=" ➕ Přidat investici"></Button>
            <Button Grid.Row="2" Click="ShowTransactionsButton_Click" Width="150" Content=" 📋 Zobrazit transakce"></Button>
            <Button Grid.Row="3" Click="SettingsButton_Click" Width="150" Content=" ⚙️ Nastavení aplikace"></Button>
            <Button VerticalAlignment="Bottom" Grid.Row="4" Click="GoBackButton_Click" Width="150" Height="20" Content=" ⬅️ Odhlásit" Margin="0,0,0,10"></Button>

        </Grid>
        <Grid Grid.Column="1" Background="GhostWhite">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#2f3c61"></Setter>
                </Style>
            </Grid.Resources>
            
            <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="20" Text="{Binding UserHeaderTextBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="10"></TextBlock>

            <TextBlock Grid.Row="1" Text="Zde můžete sledovat své investice." Foreground="Gray" FontWeight="SemiBold" Margin="10,0,0,0"></TextBlock>

            <Grid Grid.Row="2" Margin="0,20,0,0" Height="90" HorizontalAlignment="Left" Width="650">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="190" Margin="10,0,10,0">
                    <Border Background="#345eeb" BorderThickness="0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="10,15,0,0" Text="Celková hodnota"></TextBlock>
                            <TextBlock Foreground="White" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Text="{Binding PortfolioValueTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Margin="10,0,5,20" HorizontalAlignment="Left" Height="20" Width="65" FontSize="10" FontWeight="SemiBold" Content="Aktualizovat" Click="RefreshPortfolioValueButton_Click" 
                                    Background="#345eeb" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left"></Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Width="190" Margin="10,0,10,0">
                    <Border Background="White" BorderThickness="1" CornerRadius="5" BorderBrush="LightGray">
                        <StackPanel>
                            <TextBlock Foreground="Black" FontWeight="SemiBold" FontSize="13" Margin="10,15,0,0" Text="Vývoj investic"></TextBlock>
                            <TextBlock Foreground="Black" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Text="{Binding InvestmentGrowthAmount, Mode=TwoWay}"/>
                            <TextBlock Margin="10,0,5,20" HorizontalAlignment="Left" Height="20" FontSize="10" FontWeight="Bold" Text="{Binding InvestmentGrowthPercentage, Mode=TwoWay}" Foreground="{Binding InvestmentGrowthColor, Mode=TwoWay}"></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" Width="190" Margin="10,0,10,0">
                    <Border Background="White" BorderThickness="1" CornerRadius="5" BorderBrush="LightGray">
                        <StackPanel>
                            <TextBlock Foreground="Black" FontWeight="SemiBold" FontSize="13" Margin="10,15,0,0" Text="Investovaná částka"></TextBlock>
                            <TextBlock Foreground="Black" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Text="{Binding InvestedMoneyTextBox, Mode=TwoWay}"/>
                            <TextBlock Margin="10,0,5,20" HorizontalAlignment="Left" Height="20" FontSize="10" FontWeight="SemiBold" Text="{Binding InvestmentsCountTextBox, Mode=TwoWay}" Foreground="Gray"></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

