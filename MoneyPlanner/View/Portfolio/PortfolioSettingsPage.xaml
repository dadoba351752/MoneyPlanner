<UserControl x:Class="MoneyPlanner.View.Portfolio.PortfolioSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyPlanner.View.Portfolio"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Výchozí měna:" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left"></TextBlock>
        <ComboBox Height="20" Width="70" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" ItemsSource="{Binding CurrencyComboBox}" SelectedItem="{Binding SelectedCurrency}"></ComboBox>
        <TextBlock Text="Zdroj měnových kurzů:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" ToolTip="Online = zdrojem měnových kurzů je API, Offline = měnové kurzy jsou nastaveny systémově natvrdo pro rychlejší práci (méně přesné)"></TextBlock>
        <ComboBox Height="20" Width="70" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" ItemsSource="{Binding CurrencySourceComboBox}" SelectedItem="{Binding SelectedCurrencySource}"></ComboBox>
        <Button Click="SaveButton_Click" Content="Uložit" Width="50" Height="20" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right"></Button>
        <Button Click="GoBackButton_Click" Content="Zpět" Width="50" Height="20" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"></Button>
    </Grid>
</UserControl>
