<UserControl x:Class="MoneyPlanner.View.Portfolio.PortfolioWelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoneyPlanner.View.Portfolio"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsEnabled" Value="True"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="10,10,20,10"></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="IsEnabled" Value="True"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="10,10,20,10"></Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Vítej v portfolio trackeru :)"></Label>

            <Label Grid.Row="1" FontWeight="SemiBold" Content="Vytvoř nového uživatele"></Label>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Zadej jméno:"></Label>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NameCreateTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Zadej příjmení:"></Label>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SurnameCreateTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label Grid.Row="2" Grid.Column="0" Content="Zadej rodné číslo:"></Label>
                <TextBox Grid.Row="2" Grid.Column="1"  Text="{Binding BirthNumberCreateTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Button Grid.Row="3" Width="70" Content="Vytvořit" Click="CreateButton_Click" Margin="0,10,0,10"></Button>
            </Grid>

            <Label Grid.Row="3" FontWeight="SemiBold" Content="Najdi vytvořeného uživatele"></Label>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Zadej rodné číslo včetně lomítka:"></Label>
                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding BirthNumberSearchTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                <Button Grid.Row="1" Width="70" Content="Vyhledat" Click="SearchButton_Click" Margin="0,10,0,10"></Button>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Uživatel nalezen, kliknutím se přihlásíte:" Visibility="{Binding UserFoundTextIsVisible, Mode=OneWay}"></TextBlock>
                <Button Grid.Row="2" Grid.Column="1" Click="UserFoundButton_Click" Visibility="{Binding UserFoundButtonIsVisible, Mode=OneWay}" Margin="10,0,20,0" Content="{Binding UserFoundButtonText, Mode=OneWay}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
