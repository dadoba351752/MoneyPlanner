<Window x:Class="MoneyPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyPlanner"
        mc:Ignorable="d"
        Title="MoneyPlanner" Height="1000" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" FontSize="15">
            <MenuItem Header="Domů" HorizontalAlignment="Right" Click="HomeButton_Click"/>
            <MenuItem Header="Kalkulačky">
                <MenuItem x:Name="NetIncomeCalculatorMenuButton" Header="Čistá mzda" Click="NetIncomeCalculatorMenuButton_Click"/>
                <MenuItem x:Name="MortgageCalculatorMenuButton" Header="Hypotéka"/>
                <MenuItem x:Name="CompoundInterestCalculatorMenuButton" Header="Složené úročení" Click="CompoundInterestCalculatorMenuButton_Click"/>
            </MenuItem>
            <MenuItem Header="Portfolio">
            </MenuItem>
        </Menu>
        <ContentControl x:Name="MainContent" Grid.Row="1"/>
    </Grid>
</Window>
